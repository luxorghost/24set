class Firework {
    constructor(sx, sy, tx, ty, color, isMassive) {
        this.x = sx; this.y = sy; this.tx = tx; this.ty = ty;
        this.angle = Math.atan2(ty - sy, tx - sx); this.speed = isMassive ? 10 : 6;
        this.color = color; this.isMassive = isMassive; this.done = false;
