<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Mi Novia Hermosa 💖</title>
    <!-- Fuentes premium idénticas a tus imágenes -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
        /* === CONFIGURACIÓN BASE ESTILO OSCURO / MORADO NEÓN === */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #0d0614; /* Fondo místico ultra oscuro */
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 15px rgba(255, 255, 255, 0.4); transform: scale(1); }
            100% { box-shadow: 0 0 30px rgba(236, 72, 153, 0.7); transform: scale(1.05); }
        }

            /* EFECTO MATRIX DE INTRODUCCIÓN CON ESTILO TIERNO PREMIUM */
        #intro-matrix-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        #intro-number-display {
            font-family: 'Playfair Display', serif; /* Tu tipografía principal elegante */
            font-style: italic; /* Cursiva tierna idéntica a tus títulos */
            font-size: 11rem; /* Tamaño más estilizado y menos agresivo */
            font-weight: 600;
            color: #fff6f8; /* Tono blanco crema más suave */
            /* Resplandor neón difuminado y terso, sin saturar de luz la pantalla */
            text-shadow: 0 0 10px rgba(236, 72, 153, 0.4), 0 0 25px rgba(236, 72, 153, 0.6), 0 0 45px rgba(147, 51, 234, 0.3);
            z-index: 2;
            position: relative;
            user-select: none;
            animation: introPulse 1.2s infinite alternate ease-in-out;
        }

        @keyframes introPulse {
            0% { transform: scale(0.97); text-shadow: 0 0 10px rgba(236, 72, 153, 0.4), 0 0 20px rgba(236, 72, 153, 0.5); }
            100% { transform: scale(1.03); text-shadow: 0 0 15px rgba(236, 72, 153, 0.6), 0 0 30px rgba(236, 72, 153, 0.7), 0 0 50px rgba(255, 0, 127, 0.3); }
        }



        /* Luces ambientales en las esquinas traseras */
        body::before {
            content: '';
            position: absolute;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, rgba(147, 51, 234, 0.25) 0%, rgba(0,0,0,0) 70%);
            top: -10%;
            left: -10%;
            z-index: 1;
        }

        body::after {
            content: '';
            position: absolute;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, rgba(236, 72, 153, 0.18) 0%, rgba(0,0,0,0) 70%);
            bottom: -10%;
            right: -10%;
            z-index: 1;
        }

        /* === FONDO DE CORAZONES FLOTANTES CAYENDO === */
        .hearts-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 2;
            pointer-events: none;
        }

        .heart-particle {
            position: absolute;
            color: rgba(236, 72, 153, 0.4);
            font-size: 15px;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(-20px) rotate(0deg); opacity: 0; }
            10% { opacity: 0.6; }
            90% { opacity: 0.6; }
            100% { transform: translateY(105vh) rotate(360deg); opacity: 0; }
        }

             /* === ESTRUCTURA DE LAS INTERFACES === */
        .screen {
            position: absolute;
            width: 95%;
            max-width: 1200px; /* ¡Expandido para que se vea gigante y estético en PC! */
            text-align: center;
            z-index: 10;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.8s ease-in-out forwards;
        }

        /* Ajuste extra para que las cajas del tiempo no se peguen */
        .countdown-container {
            display: flex;
            gap: 25px; /* Más espacio elegante entre los bloques */
            margin: 30px 0;
        }

        .screen.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Tipografías de los títulos */
        h1.serif-title {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-style: italic;
            font-weight: 400;
            color: #fff6f8;
            text-shadow: 0 0 20px rgba(255, 230, 235, 0.2);
            margin-bottom: 5px;
        }

        .small-tag {
            font-size: 0.75rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 25px;
        }

        .sub-message {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: #fda4af;
            font-size: 1.05rem;
            margin-top: 10px;
            margin-bottom: 30px;
        }

        /* Botones Premium con Bordes Redondeados Capsulares */
        .btn-capsule {
            background: rgba(255, 255, 255, 0.06);
            color: #fff0f2;
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 12px 35px;
            font-size: 0.85rem;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
            margin-top: 20px;
        }

        .btn-capsule:hover {
            background: #fff;
            color: #0d0614;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
            transform: translateY(-2px);
        }

        /* === INTERFAZ 1: CUENTA REGRESIVA === */
        .countdown-container {
            display: flex;
            gap: 20px;
            margin: 20px 0;
        }

        .time-box {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            width: 85px;
            height: 85px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .time-box span.num {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 600;
        }

        .time-box span.label {
            font-size: 0.65rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 2px;
        }

        /* === INTERFAZ 2: CAJA REGALO Y POLAROIDS OSCILANTES === */
        .gift-wrapper {
            position: relative;
            width: 100%;
            height: 250px;
            margin-bottom: 25px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Imagen del Hámster Animado Transparente Agrandado para PC */
        .hamster-gift-icon {
            width: 300px; /* Tamaño ampliado ideal para pantallas de laptop/computadora */
            height: auto;
            z-index: 20;
            animation: bounce 1.5s infinite alternate ease-in-out; 
            /* Mantiene el resplandor rosa envolvente */
            filter: drop-shadow(0 0 35px rgba(236, 72, 153, 0.5)); 
            mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%),
                        linear-gradient(to right, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
            -webkit-mask-image: radial-gradient(circle, rgba(0,0,0,1) 75%, rgba(0,0,0,0) 100%);
        }

    
        @keyframes bounce {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(-10px) scale(1.05); }
        }

                /* Fotos tipo Polaroid optimizadas y agrandadas para pantallas de PC/Laptop */
        .polaroid {
            position: absolute;
            background: #ffffff;
            padding: 10px 10px 28px 10px;
            width: 165px; /* ¡Fotos un 50% más grandes y visibles! */
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
            border-radius: 4px;
            z-index: 10;
            transition: transform 0.3s ease;
        }

        .polaroid img {
            width: 100%;
            height: 140px; /* Proporción ideal para el nuevo tamaño */
            object-fit: cover;
        }

         /* Posiciones máximas: fotos totalmente entrelazadas en el centro */
        .p1 { left: 70px; top: 10px; z-index: 5; animation: rockLeft 3s infinite ease-in-out alternate; }
        .p2 { left: 165px; top: 110px; z-index: 5; animation: rockRight 3.5s infinite ease-in-out alternate; }
        .p3 { right: 70px; top: 10px; z-index: 5; animation: rockRight 2.8s infinite ease-in-out alternate; }
        .p4 { right: 165px; top: 115px; z-index: 5; animation: rockLeft 3.2s infinite ease-in-out alternate; }


        @keyframes rockLeft { 0% { transform: rotate(-20deg); } 100% { transform: rotate(20deg); } }
        @keyframes rockRight { 0% { transform: rotate(20deg); } 100% { transform: rotate(-20deg); } }

        /* === INTERFAZ 3: CARTA CRISTALINA CON APARICIÓN DE LÍNEAS === */
            
                /* Carta con tamaño amplio original y sistema de lectura invisible para PC */
        .letter-container {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            border-radius: 18px;
            padding: 40px;
            width: 100%;
            max-width: 750px; /* Recupera su ancho grande original para aprovechar los lados */
            max-height: 520px; /* Altura generosa para que el texto respire con elegancia */
            overflow-y: auto;  /* Mantiene activa la función de subir y bajar con la rueda del mouse */
            text-align: justify;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            margin-top: 15px;
            position: relative;
            
            /* Oculta la barra de desplazamiento en navegadores como Firefox e Internet Explorer */
            scrollbar-width: none; 
            -ms-overflow-style: none; 
        }

        /* Oculta por completo la barra de movimiento fucsia en Chrome, Safari y Edge */
        .letter-container::-webkit-scrollbar {
            display: none; /* ¡Hace que la barra sea 100% invisible! */
            width: 0px;
            background: transparent;
        }

        .letter-line {
            font-size: 1.05rem;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 15px;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 1.2s ease, transform 1.2s ease;
        }

        .letter-line.visible {
            opacity: 1;
            transform: translateY(0);
        }
    
        /* === MOTOR VISUAL DEL CARRUSEL 3D COVERFLOW REAL === */
        .carousel-3d-container {
            position: relative;
            width: 100%;
            height: 420px;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1200px; /* Activa la profundidad tridimensional en el navegador */
            overflow: visible;
            margin-top: 10px;
        }

        .carousel-3d-track {
            position: relative;
            width: 240px;
            height: 320px;
            transform-style: preserve-3d;
            display: flex;
            justify-content: center;
            align-items: center;
        }

                .card-3d {
            position: absolute;
            width: 240px;
            height: 320px;
            background: #ffffff; /* Fondo blanco liso estilo polaroid */
            border-radius: 24px; /* Bordes redondeados más curvos y elegantes */
            padding: 12px 12px 45px 12px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7), 0 0 15px rgba(236, 72, 153, 0.15); /* Sombra intensa combinada con un halo neón rosa muy suave */
            backface-visibility: hidden;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease, filter 0.6s ease;
            user-select: none;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* Asegura que la imagen de arriba respete la curvatura de las esquinas */
        }

              .card-3d img {
            width: 100%;
            height: 245px;
            object-fit: cover;
            object-position: center;
            border-radius: 16px; /* Curvatura interna proporcional */
            pointer-events: none;
        }


        .card-3d p {
            position: absolute;
            bottom: 12px;
            left: 0;
            width: 100%;
            text-align: center;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            color: #111111; /* Texto oscuro sobre el fondo blanco */
            font-weight: 500;
            padding: 0 15px;
        }

        .carousel-3d-controls {
            display: flex;
            gap: 30px;
            margin-top: 25px;
            align-items: center;
            z-index: 50;
        }

        .btn-arrow {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .btn-arrow:hover {
            background: #ffffff;
            color: #0d0614;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        }


                /* === NUEVO BOTÓN DE REGALO PALPITANTE PREMIUM CORREGIDO === */
        .btn-gift-pulse {
            width: 90px;
            height: 90px;
            background: url('https://i.ibb.co/jP6Fwbw1/pink-pastel-gift-box-free-png.webp') center/contain no-repeat; /* Tu imagen rosa fija */
            border: none;
            cursor: pointer;
            outline: none;
            display: inline-block;
            transition: transform 0.3s ease;
            animation: giftHeartbeat 1.4s infinite ease-in-out; /* Efecto palpitante continuo */
            filter: drop-shadow(0 0 15px rgba(236, 72, 153, 0.5)); /* Resplandor neón rosa */
        }

        .btn-gift-pulse:hover {
            transform: scale(1.15);
            filter: drop-shadow(0 0 25px rgba(251, 191, 36, 0.7)); 
        }

        /* Animación de latido de corazón */
        @keyframes giftHeartbeat {
            0% { transform: scale(1); }
            14% { transform: scale(1.08); }
            28% { transform: scale(1); }
            42% { transform: scale(1.08); }
            70% { transform: scale(1); }
        }

               /* Animación mágica de destello y revelado neón para la frase final */
        @keyframes revealGlow {
            0% { transform: scale(0.92); opacity: 0; filter: blur(6px); text-shadow: 0 0 0px rgba(255,215,0,0); }
            50% { text-shadow: 0 0 45px rgba(255,215,0,0.95), 0 0 20px #ec4899; opacity: 0.8; transform: scale(1.03); }
            100% { transform: scale(1); opacity: 1; filter: blur(0); text-shadow: 0 0 20px rgba(255,215,0,0.5); }
        }

        /* Luces de Casino parpadeantes para el borde de la ruleta */
        @keyframes casinoLights {
            0% { border-color: rgba(236, 72, 153, 0.4); box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 15px rgba(236, 72, 153, 0.2); }
            50% { border-color: rgba(255, 215, 0, 0.8); box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 30px rgba(255, 215, 0, 0.4); }
            100% { border-color: rgba(236, 72, 153, 0.4); box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 15px rgba(236, 72, 153, 0.2); }
        }

        /* Animación para que el corazón completo de imágenes lata con ternura */
        @keyframes corazonLatido {
            0% { transform: translate(-50%, -50%) scale(1); }
            14% { transform: translate(-50%, -50%) scale(1.04); }
            28% { transform: translate(-50%, -50%) scale(1); }
            42% { transform: translate(-50%, -50%) scale(1.04); }
            70% { transform: translate(-50%, -50%) scale(1); }
        }

        /* ========================================================
           CÓDIGO NUEVO: ADAPTACIÓN AUTOMÁTICA PARA CELULARES
           ======================================================== */
        @media (max-width: 768px) {
            body {
                overflow-y: auto !important; /* Permite deslizar hacia abajo en celular si falta espacio */
            }
            
            .screen {
                width: 95% !important;
                padding: 10px !important;
                box-sizing: border-box;
                position: relative !important; /* Evita que se encimen elementos al hacer scroll */
                min-height: 100vh !important;
                justify-content: flex-start !important; /* Alinea arriba para dar espacio al scroll */
                padding-top: 30px !important;
            }

            /* --- PANTALLA 1: CUENTA REGRESIVA --- */
            #screen1 > div {
                flex-direction: column !important; /* Pone el GIF arriba y el contador abajo */
                align-items: center !important;
                gap: 20px !important;
            }

            #screen1 div[style*="width: 280px"] {
                width: 150px !important; /* Achica el GIF del conejo */
            }

            h1.serif-title {
                font-size: 2.1rem !important; /* Títulos medianos para que no se corten */
            }

            .time-box {
                width: 60px !important; /* Cajas de tiempo más compactas */
                height: 60px !important;
            }
            
            .time-box span.num {
                font-size: 1.2rem !important;
            }

            /* --- PANTALLA 2: REGALO Y FOTOS POLAROID --- */
            .gift-wrapper {
                height: auto !important;
                flex-direction: column !important;
                gap: 15px !important;
                margin-top: 20px !important;
            }

            .hamster-gift-icon {
                width: 140px !important; /* Achica el hámster central */
                margin-top: 10px !important;
            }

            .polaroid {
                position: relative !important; /* Quita las coordenadas fijas para que no salgan de la pantalla */
                left: 0 !important;
                right: 0 !important;
                top: 0 !important;
                width: 130px !important;
                margin: 0 auto !important;
                animation: none !important; /* Desactiva la oscilación para que sea fácil verlas */
            }
            
            #screen2 > div[style*="margin-top: 110px"] {
                margin-top: 20px !important; /* Ajusta la separación del texto inferior */
            }

            /* --- PANTALLA 3: CARTA CRISTALINA --- */
            .letter-container {
                padding: 18px !important;
                max-height: 340px !important;
            }

            #secret-trigger-container {
                left: 0 !important; /* Centra el hámster y botón sorpresa al final del texto */
                top: 0 !important;
                margin-top: 20px !important;
                margin-bottom: 0 !important;
            }

            /* --- PANTALLA 4: CARRUSEL 3D --- */
            .carousel-3d-container {
                height: 420px !important; /* Más alto para que las fotos respiren en medio */
                margin-top: 20px !important;
                margin-bottom: 20px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }
            
            .carousel-3d-track {
                width: 230px !important; 
                height: 310px !important;
            }

            .card-3d {
                width: 230px !important; /* Tarjetas mucho más grandes y visibles en celular */
                height: 310px !important;
            }
            
            .card-3d img {
                height: 235px !important; /* La imagen interna crece proporcionalmente */
            }

            /* Forzamos que la estructura de la Pantalla 4 se centre verticalmente en el móvil */
            #screen4 {
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important; /* Empuja todo el bloque al centro de la pantalla */
                align-items: center !important;
                min-height: 100svh !important;
                padding: 20px 0 !important;
            }

            /* Ajuste para que el mensaje final y las flores no queden pegados abajo */
            #final-birthday-msg-container {
                margin-top: 30px !important;
            }

            /* --- PANTALLA 5: LA RULETA DE REGALOS --- */
            #screen5 > div {
                flex-direction: column !important; /* Pone la ovejita arriba de la ruleta */
                gap: 15px !important;
            }

            #screen5 div[style*="width: 280px"] {
                width: 120px !important; /* Reduce el tamaño de la oveja */
            }

            #resultado-numero {
                font-size: 5rem !important; /* Reduce el tamaño del número gigante en la ruleta */
                min-height: 90px !important;
            }

            /* --- PANTALLA 6: CLÍMAX FINAL --- */
            #contenedor-corazon-fotos {
                width: 90% !important;
                height: 350px !important;
                transform: translate(-50%, -40%) scale(0.5) !important; /* Encoge el corazón de fotos para que entre entero en el fondo */
            }
        }

               /* === CONFIGURACIÓN ADICIONAL CUANDO EL CELULAR SE ROTA DE LADO (HORIZONTAL) === */
        @media (max-width: 950px) and (orientation: landscape) {
            html, body {
                overflow-x: auto !important; /* Habilita arrastrar la pantalla a los lados */
                overflow-y: auto !important; /* Habilita arrastrar la pantalla arriba y abajo */
                height: auto !important;
                width: auto !important;
                min-height: 100vh;
                position: relative;
                
                /* Oculta las barras grises en navegadores como Firefox */
                scrollbar-width: none !important; 
                -ms-overflow-style: none !important; 
            }
            
            /* OCULTA POR COMPLETO LAS BARRAS EN CHROME, SAFARI Y NAVEGADORES DE CELULAR */
            html::-webkit-scrollbar,
            body::-webkit-scrollbar,
            .screen::-webkit-scrollbar {
                display: none !important;
                width: 0px !important;
                height: 0px !important;
                background: transparent !important;
            }
            
            .screen {
                position: relative !important; 
                display: none;
                width: 100% !important;
                min-width: 830px !important;  /* Forza un espacio ancho fijo para poder deslizar de izquierda a derecha */
                height: auto !important;
                min-height: 140vh !important; /* Forza espacio alto suficiente para deslizar de arriba a abajo */
                padding-top: 30px !important;
                padding-bottom: 80px !important;
                box-sizing: border-box;
                justify-content: flex-start !important;
            }

            .screen.active {
                display: flex !important;
            }

            /* Mantiene estables las fotos y el hámster al mover la pantalla */
            .gift-wrapper {
                height: 250px !important;
                margin-top: 40px !important;
                margin-bottom: 40px !important;
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
            }

            /* Espaciado del texto inferior */
            #screen2 > div[style*="margin-top: 110px"] {
                margin-top: 60px !important; 
            }

            /* Permite scroll dentro de la carta sin romper el arrastre de la pantalla principal */
            .letter-container {
                max-height: 280px !important;
                overflow-y: auto !important;
            }
        }



        /* =========================================================
           CORRECCIÓN DEFINITIVA DE SCROLL PARA CELULARES
           ========================================================= */
        html {
            width: 100%;
            min-height: 100%;
            overflow-x: auto !important;
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch;
        }

        @media (max-width: 768px) {
            html,
            body {
                width: 100%;
                min-width: 0 !important;
                height: auto !important;
                min-height: 100%;
                overflow-x: auto !important;
