    update() { this.speed *= 0.95; this.x += Math.cos(this.angle) * this.speed; this.y += Math.sin(this.angle) * this.speed + 0.2; this.alpha -= this.decay; }
    draw() { ctx.fillStyle = this.color; ctx.globalAlpha = this.alpha; ctx.fillRect(this.x, this.y, 2, 2); ctx.globalAlpha = 1; }
