        if (this.y <= this.ty) { this.done = true; createParticles(this.tx, this.ty, this.color, this.isMassive); }
    }
    draw() { ctx.beginPath(); ctx.moveTo(this.x, this.y); ctx.lineTo(this.x, this.y - 5); ctx.strokeStyle = this.color; ctx.stroke(); }
}
class Particle {
    constructor(x, y, color, isMassive) {
        this.x = x; this.y = y; this.angle = Math.random() * Math.PI * 2;
        this.speed = Math.random() * (isMassive ? 8 : 6.5) + 1; this.alpha = 1; this.decay = Math.random() * 0.02 + 0.01; this.color = color;
