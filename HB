                "https://i.ibb.co/N6KtRttj/Whats-App-Image-2026-09-14-at-1-54-21-AM.jpg",
                "https://i.ibb.co/N6KtRttj/Whats-App-Image-2026-09-14-at-1-54-21-AM.jpg",
                "https://i.ibb.co/N6KtRttj/Whats-App-Image-2026-09-14-at-1-54-21-AM.jpg",
                "https://i.ibb.co/N6KtRttj/Whats-App-Image-2026-09-14-at-1-54-21-AM.jpg",
                "https://i.ibb.co/N6KtRttj/Whats-App-Image-2026-09-14-at-1-54-21-AM.jpg"
            ];

            const totalDeFotosEnCorazon = 24; 
            
            for (let i = 0; i < totalDeFotosEnCorazon; i++) {
                const fotoCard = document.createElement('div');
                
                fotoCard.style.position = 'absolute';
                fotoCard.style.width = '100px';
                fotoCard.style.height = '100px';
                fotoCard.style.background = '#ffffff';
                fotoCard.style.padding = '5px';
                fotoCard.style.borderRadius = '16px';
                fotoCard.style.boxShadow = '0 10px 25px rgba(0,0,0,0.5), 0 0 15px rgba(236, 72, 153, 0.4)';
                fotoCard.style.overflow = 'hidden';
                
                fotoCard.style.left = 'calc(50% - 50px)';
                fotoCard.style.top = 'calc(50% - 50px)';
                fotoCard.style.transform = `scale(0) rotate(${Math.random() * 60 - 30}deg)`;
                fotoCard.style.opacity = '0';
                fotoCard.style.transition = 'all 1.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';

                const img = document.createElement('img');
                img.src = misFotosGaleria[i % misFotosGaleria.length]; 
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';
                img.style.borderRadius = '12px';
                
                fotoCard.appendChild(img);
                contenedor.appendChild(fotoCard);

                const t = (i / totalDeFotosEnCorazon) * Math.PI * 2;
                const escalaX = 14; 
                const escalaY = 12; 
                
                const posX = 16 * Math.pow(Math.sin(t), 3) * escalaX;
                const posY = -(13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t)) * escalaY;

                        setTimeout(() => {
                    fotoCard.style.left = `calc(50% - 50px + ${posX}px)`;
                    fotoCard.style.top = `calc(50% - 50px + ${posY}px)`;
                    fotoCard.style.transform = `scale(1) rotate(${Math.random() * 16 - 8}deg)`;
                    fotoCard.style.opacity = '1';
                }, 100 + (i * 45));
            }
        }

        // Activa el latido continuo en el contenedor un segundo después de que se abran las fotos
        setTimeout(() => {
            const contenedorCorazon = document.getElementById('contenedor-corazon-fotos');
            if (contenedorCorazon) {
                contenedorCorazon.style.animation = 'corazonLatido 1.6s infinite ease-in-out';
            }
        }, 1500);

    </script>

